#the mod name as displayed in-game
displayName: "Create Mod"

#the internal name of your mod
name: "create"

#your name
author: "郑zip"

#the fully qualified main class of the mod
main: "zzw.TestMod"

#the mod description as seen in the mod dialog
description: "为游戏加入一整套金属加工与机械动力系统：开采原料、熔炼合金、压制金属板，再用齿轮与传动轴把动力输送到各处。还加入了可自由拼装的模块化方块、经验收集与分配网络。首领方面包含体型庞大的多节单位（电弧虫、毒雾虫、吸血虫、噬界虫、压迫者），以及两支全新阵营的飞行与地面单位、载具、直升机与海军旗舰。另有丰富的墙体与地板，并附带防作弊、时间停止等特殊机制，灵感来源于Minecraft的Create与PU132。"

#the mod version
version: 2.2.3

#the minimum game build required to run this mod
# ★ 160 分支: 编译目标为 Mindustry 160.1 (Java 17), 不能用于 158;
#   master 分支保持 v158.1 版本, 两边互不影响
minGameVersion: 160

#this is a java mod
java: true
